{
  "manifest_version": 3,
  "name": "Auto Load More for KSP",
  "version": "1.5.0",
  "description": "Automatically loads more products on KSP category pages in batches you choose. No more clicking \"More results\" again and again.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://ksp.co.il/*", "https://*.ksp.co.il/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
